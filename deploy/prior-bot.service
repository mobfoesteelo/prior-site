[Unit]
Description=PRIOR · X-posting bot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__PRIOR_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/scripts/prior_bot.py
ExecStartPost=/bin/bash __INSTALL_DIR__/deploy/push-data.sh

# basic hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__INSTALL_DIR__
PrivateTmp=true

# logs
StandardOutput=journal
StandardError=journal
