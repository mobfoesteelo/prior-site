# PRIOR RNG · environment

# Solana RPC — server-side (kept private)
SOLANA_RPC_URL=https://rpc.solanatracker.io/public

# Solana RPC — client-side (must be public, exposed to browser)
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc.solanatracker.io/public

# Agent token mint — PRIOR's pump.fun mint
# Used by the @pump-fun/agent-payments-sdk to derive the invoice PDA.
# Funds flow per pump.fun's tokenized-agents mechanic.
NEXT_PUBLIC_AGENT_TOKEN_MINT_ADDRESS=6JMRacQ3JJdTNQ1qtg59f8h91aAPMjNhTtkixQHDpump

# Currency — wSOL (wrapped SOL) so price is denominated in SOL.
# Switch to USDC mint (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v) for stablecoin pricing.
NEXT_PUBLIC_CURRENCY_MINT=So11111111111111111111111111111111111111112

# Price in smallest unit. wSOL = 9 decimals, so 0.1 SOL = 100_000_000.
# (USDC = 6 decimals, so 0.1 USDC would be 100_000.)
NEXT_PUBLIC_PRICE_AMOUNT=100000000

# Price in human-readable form for the UI.
NEXT_PUBLIC_PRICE_LABEL=0.1 SOL

# Invoice validity window in seconds (24h default).
INVOICE_TTL_SECONDS=86400
